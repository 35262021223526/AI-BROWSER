<Application x:Class="NovaBrowser.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="AppBackground" Color="#101421"/>
    <SolidColorBrush x:Key="PanelBackground" Color="#191F30"/>
    <SolidColorBrush x:Key="TextBrush" Color="#F4F6FF"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#A8B1C7"/>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="Background" Value="#252D42"/>
      <Setter Property="BorderBrush" Value="#39445D"/>
      <Setter Property="Padding" Value="12,7"/>
      <Setter Property="Margin" Value="3"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
  </Application.Resources>
</Application>
