<Window x:Class="NovaBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Nova Browser" Height="820" Width="1280" MinHeight="560" MinWidth="850"
        Background="{StaticResource AppBackground}" Foreground="{StaticResource TextBrush}">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#151B29" BorderBrush="#30394F" BorderThickness="0,0,0,1" Padding="10,8">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="✦ Ask Copilot" Click="OpenCopilot_Click"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <Button Content="‹" FontSize="18" Width="38" Click="Back_Click" ToolTip="Back"/>
          <Button Content="›" FontSize="18" Width="38" Click="Forward_Click" ToolTip="Forward"/>
          <Button Content="↻" FontSize="17" Width="38" Click="Reload_Click" ToolTip="Reload"/>
          <TextBox x:Name="AddressBox" MinWidth="350" VerticalContentAlignment="Center" Padding="12,7"
                   Background="#1A2030" Foreground="#F4F6FF" BorderBrush="#39445D"
                   KeyDown="AddressBox_KeyDown" Text="https://www.bing.com"/>
          <Button Content="Go" Click="Go_Click"/>
          <Button Content="Home" Click="Home_Click"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Background="#151B29" BorderBrush="#30394F" BorderThickness="0,1,0,0" Padding="12,6">
      <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedBrush}" Text="Ready"/>
    </Border>
    <wv2:WebView2 x:Name="Browser" DefaultBackgroundColor="#101421"/>
  </DockPanel>
</Window>
